Vex {
  Level0 = Level1
  Level1 = AndExp "or" OrExp --or
  				| OrExp
  Exp =
  	| Relational
    | Bitwise
    | Relational
    | String
    

  AddExp
    = AddExp "+" MulExp  -- plus
    | AddExp "-" MulExp  -- minus
    | MulExp

  MulExp
    = MulExp "*" ExpExp  -- times
    | MulExp "/" ExpExp  -- divide
    |MulExp "%" ExpExp --mod
    | ExpExp

  ExpExp
    = PriExp "^" ExpExp  -- power
    | PriExp

  PriExp
    = "(" Exp ")"  -- paren
    | "-" PriExp   -- neg
    | GridValues
    | Number

  GridValues
  = CellRValue
  | Statistical
  
  OrExp
   = AndExp "or" AndExp --or
   | AndExp
    
   
   AndExp
   =AndExp "and"  Relational--not
   | Relational
   
   NotExp
   = Boolean
   | "not" Boolean --not
   | "(" OrExp ")" --parenthesis
   
LogicalOp
= "and"
| "or"
    
  Boolean
  	= "True"
    | "False"
    
  Bitwise
  = AddExp "&" Bitwise --bitwiseand
  | AddExp "||" Bitwise --bitwiseor
  | AddExp "^^" Bitwise --bitwisexor
  | AddExp "<<" Bitwise --lshift
  | AddExp ">>" Bitwise --rshift
  | AddExp
  
 Relational
 = AddExp "<" AddExp --Relational
 | AddExp ">" AddExp --greaterthen
 | AddExp
 | Boolean
 
 RelationalOp
 = "<="
 | ">="
 | "=="
 | "!="
 | "<"
 | ">"

CellLValue
 = "["CellAddress"]"
 CellRValue
= "#["CellAddress"]"
 CellAddress
 = AddExp","AddExp
 
 Statistical
 = StatOp"("CellLValue","CellLValue")"
 
 StatOp
 = "Mean"
 | "Min"
 | "Max"
 | "Sum"
 
  Int
  = digit*
  
  Float
  = digit*"."digit *
  
  Number  (a number)
    = Int --int
    | Float
   	| "cast" Number --Cast
    
   String
   = ""

}