GridFlow {
  Level0 = Exp1
  Exp1 =  OrExp
  OrExp 
  = AndExp "or" AndExp --or
   | AndExp
   
  AndExp
  = NotOp "and" NotOp --and
  | NotOp
  
  NotOp
  = "!"Comparison --not
  | Comparison
  
  Comparison 
  = BitwiseOr LogicalOp BitwiseOr --logical
  | BitwiseOr
  
  BitwiseOr
  = BitwiseOr "|" BitwiseXor --xor
  | BitwiseXor
  
  BitwiseXor
  = BitwiseXor "^" BitwiseAnd --bitwisexor
  | BitwiseAnd
  
  BitwiseAnd
  = BitwiseAnd "&" BitwiseShift --bitwiseand
  | BitwiseShift
  
  BitwiseShift
  = BitwiseShift ">>" AddExp --rshift
  | BitwiseShift "<<" AddExp --lshift
  | AddExp
  
    
  AddExp
    = AddExp "+" MulExp  -- plus
    | AddExp "-" MulExp  -- minus
    | MulExp

  MulExp
    = MulExp "*" ExpExp  -- times
    | MulExp "/" ExpExp  -- divide
    |MulExp "%" ExpExp --mod
    | ExpExp

  ExpExp
    = PriExp "^" ExpExp  -- power
    | PriExp

  PriExp
    = "(" Exp1 ")"  -- paren
    | "-" PriExp   -- neg
    | Number

LogicalOp
= ">"
| "<"
| ">="
| "<="
| "=="
| "!="

  Int
  = digit*
  
  Float
  = digit*"."digit *
  
  Number  (a number)
    = 
    Cast
    |GridValue
    | Boolean
    | Int--int
    | Float
    | Cast
    | Boolean
  
  Cast = 
  "float(" Int ")"
  | "int("Float")"
  GridValue 
  = CellRValue
  | Statistical
  Statistical
 = StatOp"("CellLValue","CellLValue")"
  
  StatOp
 = "Mean"
 | "Min"
 | "Max"
 | "Sum"
 
CellLValue
 = "["CellAddress"]"
   CellRValue
= "#["CellAddress"]"

 CellAddress
 = AddExp","AddExp
    
   String
   = ""
    Boolean
  	= "True"
    | "False"

}